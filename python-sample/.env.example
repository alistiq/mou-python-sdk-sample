MOU_HOST=your-mou-host.example.com
MOU_USER_NAME=your-pod-username
MOU_SERVICE_NAME=your-service-name
MOU_SERVICE_SECRET=your-service-secret

# service specific configuration
MOU_SERVICE_ID=${MOU_SERVICE_NAME}
MOU_SERVICE_POD_NAME=${MOU_SERVICE_NAME}
MOU_SERVICE_CLIENT_ID=${MOU_SERVICE_NAME}
MOU_SERVICE_CLIENT_SECRET=${MOU_SERVICE_SECRET}
MOU_CONSENT_CLIENT_ID=${MOU_SERVICE_NAME}
MOU_CONSENT_CLIENT_SECRET=${MOU_SERVICE_SECRET}

# deployment specific configuration
MOU_IAM_SERVICE_URI=https://${MOU_HOST}:8443/
MOU_IAM_REALM=service
MOU_IAM_CONSENT_REALM=service
MOU_USER_REALM=holder
MOU_POD_SERVICE_URI=https://${MOU_HOST}:3000/
MOU_NOTIFICATION_SERVICE_URI=https://${MOU_HOST}:3443/
MOU_DECRYPT_SERVICE_URI=https://${MOU_HOST}:3443/
MOU_VC_SERVICE_URI=https://${MOU_HOST}:4443/
MOU_COMMON_CONTEXT_URI=https://${MOU_HOST}:3343/contexts/mou-common

# optional global configuration
GLOBAL_TIMEOUT=10
MOU_WALLET_PASSWORD=your-wallet-password

# DANGER: disables TLS certificate verification for all outgoing HTTP clients.
# Never set this to "true" outside of local development against a self-signed test server.
MOU_DISABLE_SSL_VERIFICATION=false
